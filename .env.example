# ──────────────────────────────────────────────────────────────────────────────
#  BRING YOUR OWN KEYS — server-side placeholders.
#  Copy to .env.local and fill in. Keys are read at runtime, never committed.
#  (You can also paste keys directly in the app UI: "⚙ Keys" modal — they are
#   kept in your browser's localStorage and sent per-request, never stored
#   server-side.)
# ──────────────────────────────────────────────────────────────────────────────

# Etherscan V2 multichain API key (works for eth/bsc/base/polygon/arbitrum/…)
# https://etherscan.io/apis  → free tier: 5 req/s
ETHERSCAN_API_KEY=

# Alchemy API key — wallet transfer radar, on-chain balances, token metadata
# https://www.alchemy.com/  → free tier: 300M compute units/month (best value)
ALCHEMY_API_KEY=

# Moralis Web3 Data API key — unlocks full holder lists + wallet swap radar (USD values)
# https://moralis.io/  → free tier available
MORALIS_API_KEY=

# GeckoTerminal Pro (Data Cupboard) key — raises 30 req/min free limit
# https://www.geckoterminal.com/dex-api
GECKOTERMINAL_API_KEY=

# Birdeye key (Solana wallet radar) https://birdeye.so
BIRDEYE_API_KEY=
INDEXER_MAX_BACKFILL_DAYS=14
